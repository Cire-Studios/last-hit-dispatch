# Server-only Turnstile verification key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Server-only incoming webhook for a private staff Discord channel
DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Server-only Supabase connection. Use the secret key from Settings > API Keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Server-only MailerLite subscription settings
MAILERLITE_API_KEY=your_mailerlite_api_key
MAILERLITE_GROUP_UPDATES=your_updates_group_id
MAILERLITE_GROUP_PLAYTEST=your_playtest_group_id

# Server-only reservation confirmations and reminders
RESEND_API_KEY=your_resend_api_key
PLAYTEST_EMAIL_FROM="Last Hit Playtests <playtests@example.com>"
PLAYTEST_REPLY_TO=playtests@example.com

# Server-only playtest command center access
PLAYTEST_ADMIN_EMAIL=owner@example.com
PLAYTEST_ADMIN_SESSION_SECRET=generate_a_random_value_at_least_32_characters_long

# Vercel adds this value to the Authorization header for scheduled requests.
CRON_SECRET=generate_a_random_value_at_least_16_characters_long
# Optional overlap during secret rotation
CRON_SECRET_PREVIOUS=

# Local visual QA only. Never enable for production reservations.
PLAYTEST_DEMO_MODE=false
